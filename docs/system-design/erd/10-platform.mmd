        datetime last_location_at "nullable"
        datetime last_seen_at "nullable"
        tinyint is_active
        datetime logged_at "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    device_tracking_logs {
        int tracking_id "application identity; not database PK"
