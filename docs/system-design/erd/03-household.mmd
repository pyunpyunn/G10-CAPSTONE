        timestamp updated_at "nullable"
        timestamp deleted_at "nullable"
        tinyint is_apartment "nullable"
        varchar building_name "nullable"
        varchar floor_number "nullable"
        varchar unit_number "nullable"
        varchar room_number "nullable"
        varchar landmark "nullable"
    }
    barangay_boundaries {
        varchar psgc_code PK
