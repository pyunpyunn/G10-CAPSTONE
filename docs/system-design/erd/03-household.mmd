    addresses {
        int address_id PK "application reference"
        int street_address "nullable"
        varchar street "nullable"
        int barangay_id "nullable; application reference"
        varchar barangay_name "nullable"
        int sitio_id "nullable; application reference"
        varchar purok_sitio "nullable"
        varchar house_number "nullable"
