    echo --> reread["Refresh only affected authorized data"]
    reread --> routes
    fallback["Visibility-aware polling if realtime is unavailable"] --> routes
    scheduler["Scheduler: alerts, weather, reminders and rescue criteria"] --> modules
    modules --> execution["Jobs: synchronous locally; worker required for asynchronous drivers"]
    execution --> push["OneSignal and browser push delivery"]
