flowchart LR
    public["Public inquiry sender"] --> inquiry["Submit inquiry; administrator reviews and updates status"]
    users["Account holders"] --> auth["Authenticate, recover access and enter permitted workspace"]
    auth --> household["Resident: setup, profile, member/device ownership and geotag"]
    household --> trusted["Resident: trusted-household invitation, decision and PIN authorization"]
    auth --> admin["Operations/Admin: personnel, roles, teams and configuration"]
    auth --> weather["Permitted HQ: weather, advisory, hazard and map review"]
    weather --> event["Authorized publisher: declare event and send instructions"]
    event --> alert["Resident: receive/review alert and configured status choices"]
    alert --> status["Resident or trusted reporter: submit safety status and review history"]
    trusted --> status
    status --> monitor["HQ: monitor incidents, household safety and area priority"]
    monitor --> dispatch["Dispatcher: assign available team and route"]
    dispatch --> rescue["Rescuer: accept, travel, arrive, assess members and report findings"]
    rescue --> radio["Rescuer: internet PTT and operational logging"]
    rescue --> evacuation["Resident QR and authorized evacuation verification; complete staff UI is a gap"]
    rescue --> request["Team leader: personnel, equipment or supplies request"]
    external["Authorized external partner"] --> request
    request --> decision["HQ approver: validate, return/cancel or forward eligible request"]
    decision --> tracking["TrackingAid: acknowledgment and fulfillment mirror when available"]
    status & rescue & evacuation & tracking --> report["HQ: generate, synchronize, lock and export SitRep"]
    report --> exchange["Controlled partner report release and external-source review"]
    report --> escalation["Manual report handoff to city authority"]
    report --> archive["Authorized incident archive and saved-group management"]
    auth --> offline["Mobile: restore complete last-synced page and show Offline mode"]
    offline --> navsync["Rescuer: supported offline trip recording and reconnect event sync"]
    offline -. "required gap" .-> statusqueue["Durable offline household status queue and replay"]
    sms["Configured inbound SMS gateway"] --> status
    inquiry & admin & event & monitor & report --> notices["Permitted notifications, search, audit and history"]
    notices --> logout["Sign out and clear account-scoped local access"]
