    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.11",
    "onesignal-expo-plugin": "^2.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
