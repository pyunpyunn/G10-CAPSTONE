# Set a stable HTTPS address for standalone APKs. Can also be changed on sign-in.
# Development only: leave empty to use the Metro LAN host.
EXPO_PUBLIC_API_BASE_URL=
# Optional ordered API routes, comma-separated. Each must reach the same Laravel backend/database.
EXPO_PUBLIC_API_FALLBACK_URLS=
EXPO_PUBLIC_ONESIGNAL_APP_ID=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_ENABLE_NATIVE_ANDROID_MAPS=false
