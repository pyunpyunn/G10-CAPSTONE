{
  "version": 8,
  "name": "RESQPERATION Mambaling",
  "metadata": {
    "resqperation:pack-version": "1",
    "resqperation:extent": "Mambaling boundary with 300 m buffer",
    "attribution": "© OpenStreetMap contributors"
  },
  "glyphs": "/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "mambaling": {
      "type": "vector",
      "url": "mbtiles://mambaling",
      "minzoom": 12,
      "maxzoom": 16,
      "bounds": [123.869, 10.281, 123.8855, 10.298],
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f2f4f1" }
    },
    {
      "id": "water-fill",
      "type": "fill",
      "source": "mambaling",
      "source-layer": "water",
      "paint": { "fill-color": "#a9d9df", "fill-opacity": 1 }
    },
    {
      "id": "waterway-line",
      "type": "line",
      "source": "mambaling",
      "source-layer": "waterway",
      "paint": { "line-color": "#75bdc8", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.8, 17, 3] }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "mambaling",
      "source-layer": "roads",
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1.4, 17, 7]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "mambaling",
      "source-layer": "roads",
      "paint": {
        "line-color": [
          "match", ["get", "class"],
          ["motorway", "trunk", "primary"], "#e1a35a",
          ["secondary", "tertiary"], "#e8c988",
          ["footway", "path", "pedestrian", "steps", "track"], "#99a99b",
          "#d4d8d2"
        ],
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.7, 17, 5]
      }
    },
    {
      "id": "street-labels",
      "type": "symbol",
      "source": "mambaling",
      "source-layer": "roads",
      "minzoom": 13,
      "filter": ["has", "name"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 10, 17, 13],
        "text-max-angle": 35,
        "text-keep-upright": true
      },
      "paint": {
        "text-color": "#35433e",
        "text-halo-color": "#f8faf7",
        "text-halo-width": 1.2
      }
    }
  ]
}