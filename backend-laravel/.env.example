APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
LOCAL_QUERY_PROFILE=false
# Always set APP_DEBUG=false in deployed production environments.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=resq_local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=resq_local
DB_USERNAME=root
DB_PASSWORD=
DB_CONNECTION_TIMEOUT=5
# Server wait for more request data from the client; this is not a query execution limit.
DB_READ_TIMEOUT=30

# Canonical RESQPERATION local database connection. These values override DB_* when set.
RESQ_LOCAL_DB_CONNECTION=mysql
RESQ_LOCAL_DB_HOST=127.0.0.1
RESQ_LOCAL_DB_PORT=3306
RESQ_LOCAL_DB_DATABASE=resq_local
RESQ_LOCAL_DB_USERNAME=root
RESQ_LOCAL_DB_PASSWORD=
RESQ_LOCAL_DB_TIMEOUT=5
# Same MySQL net_read_timeout setting for this connection.
RESQ_LOCAL_DB_READ_TIMEOUT=30

# To connect to the shared DB, edit only these DB_* values in .env.
# Keep SESSION_DRIVER=file, QUEUE_CONNECTION=sync, and CACHE_STORE=file for safer development.

TRACKINGAID_DB_CONNECTION=mysql
TRACKINGAID_DB_HOST=127.0.0.1
TRACKINGAID_DB_PORT=3306
TRACKINGAID_DB_DATABASE=trackingaid_db
TRACKINGAID_DB_USERNAME=trackingaid-username
TRACKINGAID_DB_PASSWORD=trackingaid-password
TRACKINGAID_DB_TIMEOUT=5
TRACKINGAID_DB_READ_TIMEOUT=30
TRACKINGAID_FORWARD_TABLE=resqperation_forwarded_requests

EXTERNAL_REQUEST_INTAKE_KEY=change-this-shared-request-key

SAFETRACK_BARANGAY_NAME="Mambaling"
SYSTEM_BARANGAY_NAME="Barangay Mambaling"
SYSTEM_BARANGAY_LATITUDE=10.2922
SYSTEM_BARANGAY_LONGITUDE=123.8763
SYSTEM_CITY_NAME="Cebu City"
SYSTEM_PROVINCE_NAME="Cebu"
SYSTEM_MAP_ZOOM=17
SYSTEM_MAP_BOUNDS_JSON="[[10.2820,123.8700],[10.2972,123.8842]]"
WEATHER_LOCATION_NAME="Barangay Mambaling"
WEATHER_LATITUDE=10.2922
WEATHER_LONGITUDE=123.8763
WEATHER_SSL_VERIFY=false
PAGASA_TENDAY_TOKEN=
PAGASA_TENDAY_BASE_URL=https://tenday.pagasa.dost.gov.ph/api/v1
PAGASA_TENDAY_LOCATION=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# TrackingAid handoffs use the separate database-backed trackingaid_outbox queue.
# Run the Laravel scheduler every minute. It drains trackingaid_outbox and operations_outbox.
# Or run both queue workers under a process supervisor.

CACHE_STORE=file
SCHEMA_CAPABILITY_CACHE=true
SCHEMA_CAPABILITY_CACHE_STORE=file
# Increment after applying schema migrations so cached table/column capabilities refresh.
SCHEMA_CACHE_VERSION=1
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MAP_BARANGAY_NAME="Barangay Mambaling"
MAP_BARANGAY_LATITUDE=10.2922
MAP_BARANGAY_LONGITUDE=123.8763
MAP_BARANGAY_ZOOM=17
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_SSL_VERIFY=false

ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

SMS_GATEWAY_BASE_URL=http://192.168.1.100:8080
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_MESSAGE_PATH=/message
SMS_GATEWAY_BATCH_SIZE=20
SMS_GATEWAY_WEBHOOK_SIGNING_KEY=
