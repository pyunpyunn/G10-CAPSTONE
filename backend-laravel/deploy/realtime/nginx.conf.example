# In the http context. Replace hosts, certificates and API upstreams.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
upstream resq_reverb {
    least_conn;
    server reverb-a.internal:8090;
    server reverb-b.internal:8090;
}
server {
    listen 443 ssl;
    server_name ws.example.com;
    ssl_certificate /etc/ssl/resq/fullchain.pem;
    ssl_certificate_key /etc/ssl/resq/privkey.pem;
    location /app/ {
        proxy_pass http://resq_reverb;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
    }
    # Publish endpoints are reachable only through the private network.
    location /apps/ { deny all; }
}
