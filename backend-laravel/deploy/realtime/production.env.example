APP_ENV=production
APP_DEBUG=false
REALTIME_DURABLE=true
REALTIME_QUEUE_CONNECTION=realtime_redis
REALTIME_BATCH_SIZE=500
REALTIME_READ_CACHE=true
REALTIME_CACHE_STORE=redis
REDIS_PREFIX=resq-production:
REDIS_CLIENT=predis
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-managed-redis-secret
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
# Shared cache also makes API rate limits consistent across API servers.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=resqperation
REVERB_APP_KEY=replace-with-public-app-key
REVERB_APP_SECRET=replace-with-private-app-secret
# Laravel publishes to the INTERNAL Reverb load balancer.
REVERB_HOST=reverb.internal
REVERB_PORT=8090
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8090
REVERB_SCALING_ENABLED=true
REVERB_ALLOWED_ORIGINS=app.example.com
# Frontend builds connect to the PUBLIC WSS load balancer.
VITE_REVERB_HOST=ws.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_REVERB_APP_KEY=replace-with-public-app-key
