APP_KEY=
APP_URL=http://localhost:8000
# Keep the HTTP origin on loopback; expose it only through a TLS-terminating ingress.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8000

MYSQL_DATABASE=resqperation
MYSQL_USER=resqperation
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

TILESERVER_BIND_ADDRESS=0.0.0.0
TILESERVER_PORT=8080
TILESERVER_PUBLIC_URL=http://localhost:8080
VALHALLA_PORT=8002

MYSQL_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=256m
APP_MEMORY_LIMIT=1g
WORKER_MEMORY_LIMIT=512m
SCHEDULER_MEMORY_LIMIT=256m
VALHALLA_MEMORY_LIMIT=4g
VALHALLA_CPUS=2
VALHALLA_SERVER_THREADS=2
TILESERVER_MEMORY_LIMIT=768m
TILESERVER_CPUS=1